# ══════════════════════════════════════════════════════════
# NexusLearn AI — Backend Environment Variables
# Smart India Hackathon · FastAPI Backend
# ══════════════════════════════════════════════════════════
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. Run:  uvicorn main:app --reload --port 8000
# ══════════════════════════════════════════════════════════

# ── Google Gemini Flash (REQUIRED for all AI features) ───
# Free tier: 15 RPM, 1M TPM, 1500 RPD — enough for 2-3 days of demo use
# Get your key at: https://aistudio.google.com/app/apikey
# Without this key, the app runs in safe fallback mode
# (roadmap generation, skill gap, mentor, quiz, interview = limited)
GEMINI_API_KEY=AQ.Ab8RN6IgH0wyc3oewDV5LsjDXNPPPx6qUhzJtEc_4tPA5KYOOw
GEMINI_MODEL=gemini-2.0-flash

# ── Supabase (REQUIRED — used for auth + database) ────────
# Create a free project at: https://supabase.com
# Find these in: Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# After creating your Supabase project, run the schema:
#   psql $SUPABASE_DB_URL < complete_schema.sql

# ── Code Execution / Judge0 (OPTIONAL) ───────────────────
# Powers the LessonInterface code runner
# Get at: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-key-here

# ── CORS ──────────────────────────────────────────────────
# Frontend origins allowed to call the API
# Default: localhost:3000 (Vite dev server)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=https://your-vercel-domain.vercel.app


# ── Groq AI (REQUIRED for AI features) ───────────────────
# Powers roadmap generation, AI chat, interview, code review, notes AI
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b
