# ══════════════════════════════════════════════════════════
# NexusLearn AI — Environment Variables
# Smart India Hackathon · AI Career Copilot (India-First)
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# The frontend only needs VITE_* variables.
# Backend variables go in backend/.env

# ── Frontend (Vite) ────────────────────────────────────────
# URL of the FastAPI backend (local development)
VITE_API_URL=http://localhost:8000

# ══════════════════════════════════════════════════════════
# backend/.env  (create this file separately)
# ══════════════════════════════════════════════════════════

# ── OpenAI (REQUIRED for AI features) ─────────────────────
# Get your key at: https://platform.openai.com/api-keys
# Used for: Skill gap analysis, roadmap generation, AI mentor, mock interview, quiz evaluation
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini   # or gpt-4o, gpt-3.5-turbo

# ── Database (REQUIRED) ───────────────────────────────────
# SQLite (default — no setup needed for local dev)
# DATABASE_URL=sqlite:///./nexuslearn.db
# PostgreSQL (production recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/nexuslearn

# ── Authentication (REQUIRED) ────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=your-super-secret-key-here
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# ALGORITHM=HS256

# ── CORS (optional — defaults to localhost:3000) ──────────
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ── Code Execution (optional) ────────────────────────────
# Judge0 API for running user code in LessonInterface
# Get your key at: https://rapidapi.com/judge0-official/api/judge0-ce
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your-rapidapi-key-here

# ── Job Listings (optional) ───────────────────────────────
# For live Naukri/LinkedIn India job data (simulated if not set)
# RAPIDAPI_KEY=your-rapidapi-key-here

# ══════════════════════════════════════════════════════════
# QUICK START (local dev, no external APIs needed)
# ══════════════════════════════════════════════════════════
# 1. Frontend: cp .env.example .env  →  npm run dev
# 2. Backend:  cd backend && cp .env.example .env
#              pip install -r requirements.txt
#              uvicorn main:app --reload
# 3. Add OPENAI_API_KEY to backend/.env for full AI features
#    (app runs in safe fallback mode without it)
